{
	"schemaVersion": 1,
	"id": "learning-blocks-justfatlard",
	"version": "${version}",
	"name": "Learning Blocks",
	"description": "Learning games for young children, in a quiet classroom dimension of their own. Reading first: hear the letters, make the word, see what it does.",
	"authors": [
		"justfatlard"
	],
	"license": "MIT",
	"icon": "assets/learning-blocks-justfatlard/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"justfatlard.learning_blocks.LearningBlocks"
		]
	},
	"mixins": [
		"learning-blocks-justfatlard.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loaderVersion}",
		"fabric-api": "${fabricApiVersion}",
		"minecraft": "${minecraftDependency}",
		"java": ">=25",
		"pandorical": ">=15.0.0"
	},
	"contact": {
		"homepage": "https://github.com/fatlard1993/learning-blocks",
		"sources": "https://github.com/fatlard1993/learning-blocks",
		"issues": "https://github.com/fatlard1993/learning-blocks/issues"
	}
}
